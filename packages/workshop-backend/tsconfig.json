{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"],
    "outDir": "./dist",
    "rootDir": "..",
    "declaration": true,
    "sourceMap": true,
    "noEmit": false,
    "paths": {
      "@gadgets/typed-storage": ["../typed-storage/src/index.ts"],
      "@gadgets/workshop-shared/*": ["../workshop-shared/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
